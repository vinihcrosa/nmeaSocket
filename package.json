{
  "name": "nmeasocket",
  "version": "1.0.4",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov",
    "test:watch": "vitest",
    "prepare": "husky",
    "release": "release-it"
  },
  "keywords": [
    "typescript",
    "library",
    "nmea",
    "nmea-0183",
    "tcp",
    "socket",
    "gps",
    "marine",
    "ais"
  ],
  "author": "Vinicius Rosa",
  "license": "MIT",
  "description": "TypeScript client for reading and writing NMEA 0183 sentences over TCP, with per-sentence listeners and automatic reconnection.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinihcrosa/nmeaSocket.git"
  },
  "homepage": "https://github.com/vinihcrosa/nmeaSocket#readme",
  "bugs": {
    "url": "https://github.com/vinihcrosa/nmeaSocket/issues"
  },
  "dependencies": {
    "client-nmea-socket-to-event": "^1.1.6",
    "socketstream2event": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/node": "^22.15.21",
    "@vitest/coverage-istanbul": "^3.1.4",
    "husky": "^9.1.7",
    "release-it": "^19.0.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
